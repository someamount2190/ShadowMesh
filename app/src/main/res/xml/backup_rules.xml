<?xml version="1.0" encoding="utf-8"?>
<!--
    Android ≤11 (API ≤30) full-backup content rules.
    For API 31+ use data_extraction_rules.xml above; both files are declared
    in the manifest so the OS picks the right one by API level.
-->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
